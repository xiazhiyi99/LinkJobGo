{
  "name": "@job-assistant/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node src/index.js",
    "build": "prisma generate --schema src/prisma/schema.prisma && node --check src/index.js",
    "lint": "node --check src/index.js",
    "test": "node --check src/index.js && node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "prisma:generate": "prisma generate --schema src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/prisma/schema.prisma"
  },
  "dependencies": {
    "@alicloud/captcha20230305": "1.1.4",
    "@alicloud/openapi-client": "^0.4.15",
    "@prisma/client": "^6.16.2",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  }
}
