DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_assistant_dev
REDIS_URL=redis://localhost:6379
POSTGRES_USER=lingke
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lingke
REDIS_PASSWORD=change-me
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
SESSION_COOKIE_SECURE=false
AI_API_KEY=
AI_PROVIDER_MODE=fake
AI_FAKE_FAILURES=0
AI_CHEAP_PROVIDER=openai-compatible
AI_CHEAP_BASE_URL=
AI_CHEAP_API_KEY=
AI_CHEAP_MODEL=
FF_RULES_API_BASE=http://127.0.0.1:3001
FF_RULES_ACCESS_TOKEN=
# Optional; Fast Fill uses these for the database resume context. If empty,
# it reuses the rule lookup API/token on the local demo server.
FF_PROFILE_API_BASE=http://127.0.0.1:3001
FF_PROFILE_ACCESS_TOKEN=
AI_OFFICIAL_PROVIDER=openai-compatible
AI_OFFICIAL_BASE_URL=
AI_OFFICIAL_API_KEY=
AI_OFFICIAL_MODEL=
AI_VLM_CHEAP_PROVIDER=openai-compatible
AI_VLM_CHEAP_BASE_URL=
AI_VLM_CHEAP_API_KEY=
AI_VLM_CHEAP_MODEL=
AI_VLM_OFFICIAL_PROVIDER=openai-compatible
AI_VLM_OFFICIAL_BASE_URL=
AI_VLM_OFFICIAL_API_KEY=
AI_VLM_OFFICIAL_MODEL=
AI_MAX_ATTEMPTS=3
AI_TIMEOUT_MS=30000
AI_RETRY_BASE_MS=500
AI_RETRY_MAX_MS=5000
# AI retry strategy: text defaults to cheap -> cheap -> official; vision defaults to official only
AI_TEXT_RETRY_STRATEGY=cheap_then_official
AI_VLM_RETRY_STRATEGY=official_only
AI_RESUME_RETRY_STRATEGY=cheap_then_official
AI_RESUME_TIMEOUT_MS=90000
# PDF extraction: baidu_ocr uses Baidu high-accuracy OCR without coordinates;
# vision keeps the legacy page-image VLM extractor.
RESUME_PDF_EXTRACTOR=baidu_ocr
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
# console for local development; smtp for Alibaba Cloud SMTP; resend is also supported.
MAIL_PROVIDER=console
MAIL_FROM=
MAIL_API_KEY=
# Alibaba Cloud Direct Mail (Singapore) example:
# SMTP_HOST=smtpdm-ap-southeast-1.aliyuncs.com
# Alibaba Mail enterprise mailbox example:
# SMTP_HOST=smtp.qiye.aliyun.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# For port 465, SSL is enabled automatically. Set this only when using another port.
SMTP_SECURE=
SMTP_REQUIRE_TLS=
# AES-256-GCM envelope key for IMAP/OAuth credentials; required in production.
MAIL_CREDENTIAL_KEY=
# OAuth is only needed for Gmail/Outlook mailbox synchronization.
MAIL_OAUTH_CALLBACK_BASE_URL=http://localhost:3001
MAIL_GMAIL_CLIENT_ID=
MAIL_GMAIL_CLIENT_SECRET=
MAIL_OUTLOOK_CLIENT_ID=
MAIL_OUTLOOK_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Registration email codes and CAPTCHA. Keep provider disabled locally unless
# you have configured a real CAPTCHA scene. Production must use a provider.
EMAIL_CODE_SECRET=change-me
CAPTCHA_PROVIDER=disabled
# Alibaba Captcha 2.0 (the existing Aliyun mail setup can use the same account,
# but create a RAM user and a Captcha scene; never use the root access key).
ALIYUN_CAPTCHA_REGION_ID=sgp
ALIYUN_CAPTCHA_ENDPOINT=captcha.ap-southeast-1.aliyuncs.com
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=
# Public values used by the browser only; they are not secrets.
NEXT_PUBLIC_CAPTCHA_PROVIDER=disabled
NEXT_PUBLIC_ALIYUN_CAPTCHA_REGION=sgp
NEXT_PUBLIC_ALIYUN_CAPTCHA_PREFIX=
NEXT_PUBLIC_ALIYUN_CAPTCHA_SCENE_ID=
