# Include these handlers inside the existing HTTPS site, before its Web fallback.
# Expose the authenticated workspace routes alongside the extension API.
handle /autofill-test/api/* {
    route {
        uri strip_prefix /autofill-test/api
        @allowed path /health /auth/login /auth/logout /auth/me /auth/extension/login /auth/extension/logout /profiles/me /profiles/me/* /autofill/v2/* /ai/resume/parse /ai/resume/parse-file /ai/resume/normalize /ai/autofill/suggestions /ai/vision/extract /applications /applications/* /tasks /tasks/* /calendar /mail/providers /mail-accounts /mail-accounts/* /mail-messages /mail-messages/* /sync-runs/*
        reverse_proxy @allowed autofill-test-api:3001
        respond 404
    }
}

handle /autofill-test/* {
    reverse_proxy autofill-test-web:3000
}
redir /autofill-test /autofill-test/workspace/autofill 302
